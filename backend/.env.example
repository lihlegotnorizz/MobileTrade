# MobileTrade - Backend Configuration

# Server
NODE_ENV=development
PORT=5000

# Database
MONGODB_URI=mongodb://localhost:27017/mobiletrade
# For MongoDB Atlas:
# MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/mobiletrade

# JWT
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production_12345

# PayFast Configuration
PAYFAST_MERCHANT_ID=your_merchant_id
PAYFAST_MERCHANT_KEY=your_merchant_key
PAYFAST_API_URL=https://www.payfast.co.za/

# Stripe Configuration
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_PUBLIC_KEY=pk_test_your_stripe_public_key

# Courier API Configuration
ARAMEX_API_KEY=your_aramex_api_key
ARAMEX_API_URL=https://ws.aramex.com/

# The Courier Guy Configuration
COURIER_GUY_API_KEY=your_courier_guy_api_key
COURIER_GUY_API_URL=https://api.thecourierguy.co.za/

# Email Configuration (for KYC notifications)
EMAIL_SERVICE=gmail
EMAIL_USER=your_email@gmail.com
EMAIL_PASSWORD=your_app_password

# AWS S3 (for document uploads)
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_S3_BUCKET=mobiletrade-documents
AWS_S3_REGION=af-south-1
